extends RefCounted
## Shared 5x7 bitmap alphabet, drawn at integer scales without smoothing.
const GLYPHS := {
	"J": [7,2,2,2,18,18,12], "K": [17,18,20,24,20,18,17],
	"Q": [14,17,17,17,21,18,13], "Z": [31,1,2,4,8,16,31],
	"7": [31,1,2,4,8,8,8], "9": [14,17,17,15,1,1,14],
	"!": [4,4,4,4,4,0,4], "?": [14,17,1,2,4,0,4],
	",": [0,0,0,0,4,4,8], ":": [0,4,4,0,4,4,0],
	"-": [0,0,0,31,0,0,0], "/": [1,1,2,4,8,16,16],
	"(": [2,4,8,8,8,4,2], ")": [8,4,2,2,2,4,8],
	"+": [0,4,4,31,4,4,0], "&": [12,18,20,8,21,18,13],
	"F": [31,16,16,30,16,16,16], "X": [17,17,10,4,10,17,17],
	"'": [4,4,8,0,0,0,0], ".": [0,0,0,0,0,4,4],
	"H": [17,17,17,31,17,17,17],
	"B": [30,17,17,30,17,17,30],
	"Y": [17,17,10,4,4,4,4], "W": [17,17,17,21,21,27,17],
	"I": [14,4,4,4,4,4,14],
	"A": [14,17,17,31,17,17,17], "D": [30,17,17,17,17,17,30],
	"E": [31,16,16,30,16,16,31], "G": [14,17,16,23,17,17,14],
	"L": [16,16,16,16,16,16,31], "M": [17,27,21,21,17,17,17],
	"N": [17,25,25,21,19,19,17], "O": [14,17,17,17,17,17,14],
	"P": [30,17,17,30,16,16,16], "R": [30,17,17,30,20,18,17],
	"S": [15,16,16,14,1,1,30], "T": [31,4,4,4,4,4,4],
	"U": [17,17,17,17,17,17,14], "V": [17,17,17,17,17,10,4],
	"C": [14,17,16,16,16,17,14], "1": [4,12,4,4,4,4,14],
	"2": [14,17,1,2,4,8,31], "3": [30,1,1,14,1,1,30],
	"0": [14,17,19,21,25,17,14], "5": [31,16,16,30,1,1,30],
	"6": [14,16,16,30,17,17,14], "8": [14,17,17,14,17,17,14],
	"4": [2,6,10,18,31,2,2], " ": [0,0,0,0,0,0,0]
}

static func width(text: String, scale: int) -> float:
	return maxi(0, text.length() * 6 - 1) * scale

static func draw(canvas: CanvasItem, text: String, top_left: Vector2, scale: int, color: Color) -> void:
	var display = text.to_upper().replace("’", "'").replace("—", "-").replace("–", "-")
	for i in range(display.length()):
		var rows: Array = GLYPHS.get(display[i], GLYPHS["?"])
		for row in range(7):
			for col in range(5):
				if rows[row] & (1 << (4 - col)):
					canvas.draw_rect(Rect2(top_left.round() + Vector2((i * 6 + col) * scale, row * scale), Vector2.ONE * scale), color)
